{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {"deploymentEnabled": {"main": true, "**": false}},
  "functions": {
    "api/index.py": {
      "excludeFiles": "{.git/**,.local-tools/**,.local-scratch/**,.history-local/**,.forecast-local/**,tests/**,docs/**}"
    }
  },
  "rewrites": [{"source": "/(.*)", "destination": "/api/index"}]
}
